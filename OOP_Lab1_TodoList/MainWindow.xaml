<Window x:Class="TodoList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo List"
        Height="620"
        Width="980"
        MinHeight="520"
        MinWidth="860"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Todo List" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="Загрузить JSON" Margin="24,0,0,0" Click="LoadButton_Click"/>
            <Button Content="Сохранить JSON" Click="SaveButton_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Добавить" Click="AddButton_Click"/>
                        <Button Content="Изменить" Click="EditButton_Click"/>
                        <Button Content="Удалить" Click="DeleteButton_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="TasksGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="TasksGrid_SelectionChanged"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Приоритет" Binding="{Binding PriorityText}" Width="90"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="110"/>
                            <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Задача" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBlock Text="Название *"/>
                        <TextBox x:Name="TitleBox"/>

                        <TextBlock Text="Описание"/>
                        <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>

                        <TextBlock Text="Срок выполнения"/>
                        <DatePicker x:Name="DueDatePicker" Margin="0,0,0,8"/>

                        <TextBlock Text="Приоритет"/>
                        <ComboBox x:Name="PriorityCombo"/>

                        <TextBlock Text="Статус"/>
                        <ComboBox x:Name="StatusCombo" Margin="0,0,0,12"/>

                        <Button x:Name="ApplyButton" Content="Сохранить изменения" Click="ApplyButton_Click"/>
                        <Button Content="Очистить форму" Click="ClearFormButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusBarText" Margin="0,12,0,0" Foreground="#64748B"/>
    </Grid>
</Window>
